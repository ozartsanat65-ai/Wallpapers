{
  "expo": {
    "name": "TerraView",
    "slug": "terraview",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "terraview",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "android": {
      "package": "com.terraview.app"
    },
    "ios": {
      "bundleIdentifier": "com.terraview.app",
      "supportsTablet": false
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    }
  }
}
